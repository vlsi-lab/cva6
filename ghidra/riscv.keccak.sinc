# Keccak coprocessor custom instruction decoder for Ghidra
# Author: Federico Runco

# XOR3: R4-type instruction, CUSTOM-1 opcode space
# Encoding: rs3[31:27] | funct2[26:25]=0x2 | rs2[24:20] | rs1[19:15] | funct3[14:12] | rd[11:7] | opcode[6:0]=0x2B
# rd = rs1 ^ rs2 ^ rs3
:xor3 rd, rs1, rs2, rs3 is op0006=0x2B & op2526=0x2 & funct3=0x0 & rs1 & rs2 & rs3 & rd {
    rd = rs1 ^ rs2 ^ rs3;
}

# XANDN: R4-type instruction, CUSTOM-1 opcode space
# Encoding: rs3[31:27] | funct2[26:25]=0x2 | rs2[24:20] | rs1[19:15] | funct3[14:12] | rd[11:7] | opcode[6:0]=0x2B
:xandn rd, rs1, rs2, rs3 is op0006=0x2B & op2526=0x2 & funct3=0x1 & rs1 & rs2 & rs3 & rd {
    rd = rs1 ^ (~rs2 & rs3);
}

rxri_imm: val is op2526 & funct3 [ val = (op2526 << 3) | funct3; ] { 
    local tmp:1 = val; 
    export tmp;
}

# RXRI.L: R4-type instruction, CUSTOM-2 opcode space
# Encoding: rs3[31:27] | funct2[26:25]=imm43 | rs2[24:20] | rs1[19:15] | funct3[14:12] = imm210 | rd[11:7] | opcode[6:0]=0x5B
:rxri.l rd, rs1, rs2, rs3, rxri_imm is op0006=0x5B & rs1 & rs2 & rs3 & rd & rxri_imm {
    local rs3_rot:8 = (rs3 << 1) | (rs3 >> 63);
    local inner_val:8 = rs1 ^ rs2 ^ rs3_rot;

    local shift_amt:1 = rxri_imm;
    rd = (inner_val << shift_amt) | (inner_val >> (64 - shift_amt));
}

# RXRI.h: R4-type instruction, CUSTOM-2 opcode space
# Encoding: rs3[31:27] | funct2[26:25]=imm43 | rs2[24:20] | rs1[19:15] | funct3[14:12] = imm210 | rd[11:7] | opcode[6:0]=0x7B
:rxri.h rd, rs1, rs2, rs3, rxri_imm is op0006=0x7B & rs1 & rs2 & rs3 & rd & rxri_imm {
    local rs3_rot:8 = (rs3 << 1) | (rs3 >> 63);
    local inner_val:8 = rs1 ^ rs2 ^ rs3_rot;

    local shift_amt:1 = rxri_imm + 32;
    rd = (inner_val << shift_amt) | (inner_val >> (64 - shift_amt));
}
