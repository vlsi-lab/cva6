# Keccak coprocessor custom instruction decoder for Ghidra
# Author: Federico Runco

# XOR3: R4-type instruction using MADD opcode space (0x43)
# Encoding: rs3[31:27] | funct2[26:25]=0x2 | rs2[24:20] | rs1[19:15] | funct3[14:12] | rd[11:7] | opcode[6:0]=0x43
# rd = rs1 ^ rs2 ^ rs3
:xor3 rd, rs1, rs2, rs3 is op0006=0x43 & op2526=0x2 & funct3=0x0 & rs1 & rs2 & rs3 & rd {
    rd = rs1 ^ rs2 ^ rs3;
}

# XANDN: R4-type instruction using MADD opcode space (0x43)
# Encoding: rs3[31:27] | funct2[26:25]=0x2 | rs2[24:20] | rs1[19:15] | funct3[14:12] | rd[11:7] | opcode[6:0]=0x43
:xandn rd, rs1, rs2, rs3 is op0006=0x43 & op2526=0x2 & funct3=0x1 & rs1 & rs2 & rs3 & rd {
    rd = rs1 ^ (~rs2 & rs3);
}

# DXROLS: R4-type instruction using MADD opcode space (0x43)
# Encoding: rs3[31:27] | funct2[26:25]=0x2 | rs2[24:20] | rs1[19:15] | funct3[14:12] | rd[11:7] | opcode[6:0]=0x43
:dxrols rd, rs1, rs2, rs3 is op0006=0x43 & op2526=0x2 & funct3=0x2 & rs1 & rs2 & rs3 & rd {
    local rotated:8 = (rs3 << 1) | (rs3 >> 63);
    rd = rs1 ^ (rs2 ^ rotated);
}