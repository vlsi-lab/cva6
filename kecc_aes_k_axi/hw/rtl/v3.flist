// kecc-aes-k v3 RTL file list. Included via core/Flist.cva6's
// -F ${CVA6_REPO_DIR}/kecc_aes_k_axi/hw/rtl/${AES_LOOSE_VERSION}.flist -- only
// this version's flist is ever included in a given build (see the note in
// core/Flist.cva6), which is what lets v2/v3/v4/v5 all define a module named
// keccak_aes_k_top without colliding.
${CVA6_REPO_DIR}/kecc_aes_k_axi/hw/rtl/v3/pkg_keccak.sv
${CVA6_REPO_DIR}/kecc_aes_k_axi/hw/rtl/v3/aes_sbox.sv
${CVA6_REPO_DIR}/kecc_aes_k_axi/hw/rtl/v3/aes_key_mem.sv
${CVA6_REPO_DIR}/kecc_aes_k_axi/hw/rtl/v3/aes_key_mem_enc128.sv
${CVA6_REPO_DIR}/kecc_aes_k_axi/hw/rtl/v3/aes_encipher_datapath.sv
${CVA6_REPO_DIR}/kecc_aes_k_axi/hw/rtl/v3/aes_encipher_block.sv
${CVA6_REPO_DIR}/kecc_aes_k_axi/hw/rtl/v3/aes_decipher_block.sv
${CVA6_REPO_DIR}/kecc_aes_k_axi/hw/rtl/v3/aes_enc128_core.sv
${CVA6_REPO_DIR}/kecc_aes_k_axi/hw/rtl/v3/aes_core.sv
${CVA6_REPO_DIR}/kecc_aes_k_axi/hw/rtl/v3/keccak_round_constants_gen.sv
${CVA6_REPO_DIR}/kecc_aes_k_axi/hw/rtl/v3/keccak_round.sv
${CVA6_REPO_DIR}/kecc_aes_k_axi/hw/rtl/v3/keccak_aes_k_top.sv
